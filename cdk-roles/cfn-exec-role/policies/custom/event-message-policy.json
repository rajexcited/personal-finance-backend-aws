{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "sqs:TagQueue",
        "sqs:RemovePermission",
        "sqs:GetQueueUrl",
        "sqs:ListDeadLetterSourceQueues",
        "sqs:AddPermission",
        "sqs:UntagQueue",
        "sqs:PurgeQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:CreateQueue"
      ],
      "Resource": "arn:aws:sqs:*:$aws_principal_account:*${aws:PrincipalTag/appId}-${aws:PrincipalTag/environment}*"
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*"
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": ["events:List*", "events:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DeleteRule",
        "events:DescribeRule",
        "events:EnableRule",
        "events:DisableRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": [
        "arn:aws:events:*:$aws_principal_account:rule/${aws:PrincipalTag/appId}-${aws:PrincipalTag/environment}*",
        "arn:aws:events:*:$aws_principal_account:event-bus/${aws:PrincipalTag/appId}-${aws:PrincipalTag/environment}*",
        "arn:aws:events:*:$aws_principal_account:rule/${aws:PrincipalTag/appId}-${aws:PrincipalTag/environment}*/${aws:PrincipalTag/appId}-${aws:PrincipalTag/environment}*"
      ]
    }
  ]
}
